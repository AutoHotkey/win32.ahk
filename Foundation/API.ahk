#Requires AutoHotkey v2.1-alpha.37
#Include "..\_header.ahk"
#Import "Types.ahk" {*}

CloseHandle(hObject)
  => DllCall("KERNEL32.dll\CloseHandle", HANDLE, hObject, BOOL)
CompareObjectHandles(hFirstObjectHandle, hSecondObjectHandle)
  => DllCall("api-ms-win-core-handle-l1-1-0.dll\CompareObjectHandles", HANDLE, hFirstObjectHandle, HANDLE, hSecondObjectHandle, BOOL)
DuplicateHandle(hSourceProcessHandle, hSourceHandle, hTargetProcessHandle, lpTargetHandle, dwDesiredAccess, bInheritHandle, dwOptions)
  => DllCall("KERNEL32.dll\DuplicateHandle", HANDLE, hSourceProcessHandle, HANDLE, hSourceHandle, HANDLE, hTargetProcessHandle, HANDLE.Ptr, lpTargetHandle, UInt32, dwDesiredAccess, BOOL, bInheritHandle, DUPLICATE_HANDLE_OPTIONS, dwOptions, BOOL)
FreeLibrary(hLibModule)
  => DllCall("KERNEL32.dll\FreeLibrary", HMODULE, hLibModule, BOOL)
GetHandleInformation(hObject, lpdwFlags)
  => DllCall("KERNEL32.dll\GetHandleInformation", HANDLE, hObject, UInt32.Ptr, lpdwFlags, BOOL)
GetLastError()
  => DllCall("KERNEL32.dll\GetLastError", WIN32_ERROR)
GlobalFree(hMem?)
  => DllCall("KERNEL32.dll\GlobalFree", HGLOBAL, hMem?, HGLOBAL)
LocalFree(hMem?)
  => DllCall("KERNEL32.dll\LocalFree", HLOCAL, hMem?, HLOCAL)
RtlNtStatusToDosError(Status)
  => DllCall("ntdll.dll\RtlNtStatusToDosError", NTSTATUS, Status, UInt32)
SetHandleInformation(hObject, dwMask, dwFlags)
  => DllCall("KERNEL32.dll\SetHandleInformation", HANDLE, hObject, UInt32, dwMask, HANDLE_FLAGS, dwFlags, BOOL)
SetLastError(dwErrCode)
  => DllCall("KERNEL32.dll\SetLastError", WIN32_ERROR, dwErrCode, "void")
SetLastErrorEx(dwErrCode, dwType)
  => DllCall("USER32.dll\SetLastErrorEx", WIN32_ERROR, dwErrCode, UInt32, dwType, "void")
SysAddRefString(bstrString)
  => DllCall("OLEAUT32.dll\SysAddRefString", BSTR, bstrString, "HRESULT")
SysAllocString(psz?)
  => DllCall("OLEAUT32.dll\SysAllocString", "Str", psz?, BSTR)
SysAllocStringByteLen(psz?)
  => DllCall("OLEAUT32.dll\SysAllocStringByteLen", PSTR, psz?, UInt32, psz?.Length ?? 0, BSTR)
SysAllocStringLen(strIn?)
  => DllCall("OLEAUT32.dll\SysAllocStringLen", "Str", strIn?, UInt32, strIn?.Length ?? 0, BSTR)
SysFreeString(bstrString?)
  => DllCall("OLEAUT32.dll\SysFreeString", BSTR, bstrString?, "void")
SysReAllocString(pbstr, psz?)
  => DllCall("OLEAUT32.dll\SysReAllocString", BSTR.Ptr, pbstr, "Str", psz?, Int32)
SysReAllocStringLen(pbstr, psz?, len)
  => DllCall("OLEAUT32.dll\SysReAllocStringLen", BSTR.Ptr, pbstr, "Str", psz?, UInt32, len, Int32)
SysReleaseString(bstrString)
  => DllCall("OLEAUT32.dll\SysReleaseString", BSTR, bstrString, "void")
SysStringByteLen(bstr1?)
  => DllCall("OLEAUT32.dll\SysStringByteLen", BSTR, bstr1?, UInt32)
SysStringLen(pbstr?)
  => DllCall("OLEAUT32.dll\SysStringLen", BSTR, pbstr?, UInt32)
