#Requires AutoHotkey v2.1-alpha.37
#Include "..\_header.ahk"
#Import "Types.ahk" {*}
#Import "..\Foundation\Types.ahk" {BOOL, LPARAM, PSTR, PWSTR, SYSTEMTIME}
#Import "..\Graphics.Gdi\Types.ahk" {HDC}

CompareString(Locale, dwCmpFlags, lpString1, lpString2)
  => DllCall("KERNEL32.dll\CompareStringW", UInt32, Locale, UInt32, dwCmpFlags, "Str", lpString1, Int32, lpString1.Length, "Str", lpString2, Int32, lpString2.Length, COMPARESTRING_RESULT)
CompareStringEx(lpLocaleName?, dwCmpFlags, lpString1, lpString2)
  => DllCall("KERNEL32.dll\CompareStringEx", "Str", lpLocaleName?, COMPARE_STRING_FLAGS, dwCmpFlags, "Str", lpString1, Int32, lpString1.Length, "Str", lpString2, Int32, lpString2.Length, "Ptr", 0, "Ptr", 0, "Ptr", 0, COMPARESTRING_RESULT)
CompareStringOrdinal(lpString1, lpString2, bIgnoreCase)
  => DllCall("KERNEL32.dll\CompareStringOrdinal", "Str", lpString1, Int32, lpString1.Length, "Str", lpString2, Int32, lpString2.Length, BOOL, bIgnoreCase, COMPARESTRING_RESULT)
FoldStringW(dwMapFlags, lpSrcStr, lpDestStr?)
  => DllCall("KERNEL32.dll\FoldStringW", FOLD_STRING_MAP_FLAGS, dwMapFlags, "Str", lpSrcStr, Int32, lpSrcStr.Length, PWSTR, lpDestStr?, Int32, lpDestStr?.Length ?? 0, Int32)
GetACP()
  => DllCall("KERNEL32.dll\GetACP", UInt32)
GetCPInfo(CodePage, lpCPInfo)
  => DllCall("KERNEL32.dll\GetCPInfo", UInt32, CodePage, CPINFO.Ptr, lpCPInfo, BOOL)
GetCPInfoEx(CodePage, dwFlags, lpCPInfoEx)
  => DllCall("KERNEL32.dll\GetCPInfoExW", UInt32, CodePage, UInt32, dwFlags, CPINFOEXW.Ptr, lpCPInfoEx, BOOL)
GetDateFormat(Locale, dwFlags, lpDate?, lpFormat?, lpDateStr?)
  => DllCall("KERNEL32.dll\GetDateFormatW", UInt32, Locale, UInt32, dwFlags, SYSTEMTIME.Ptr, lpDate?, "Str", lpFormat?, PWSTR, lpDateStr?, Int32, lpDateStr?.Length ?? 0, Int32)
GetDateFormatEx(lpLocaleName?, dwFlags, lpDate?, lpFormat?, lpDateStr?, lpCalendar?)
  => DllCall("KERNEL32.dll\GetDateFormatEx", "Str", lpLocaleName?, ENUM_DATE_FORMATS_FLAGS, dwFlags, SYSTEMTIME.Ptr, lpDate?, "Str", lpFormat?, PWSTR, lpDateStr?, Int32, lpDateStr?.Length ?? 0, "Str", lpCalendar?, Int32)
GetDurationFormatEx(lpLocaleName?, dwFlags, lpDuration?, ullDuration, lpFormat?, lpDurationStr?)
  => DllCall("KERNEL32.dll\GetDurationFormatEx", "Str", lpLocaleName?, UInt32, dwFlags, SYSTEMTIME.Ptr, lpDuration?, Int64, ullDuration, "Str", lpFormat?, PWSTR, lpDurationStr?, Int32, lpDurationStr?.Length ?? 0, Int32)
GetOEMCP()
  => DllCall("KERNEL32.dll\GetOEMCP", UInt32)
GetStringTypeExW(Locale, dwInfoType, lpSrcStr, lpCharType)
  => DllCall("KERNEL32.dll\GetStringTypeExW", UInt32, Locale, UInt32, dwInfoType, "Str", lpSrcStr, Int32, lpCharType.Length, UInt16.Ptr, lpCharType, BOOL)
GetStringTypeW(dwInfoType, lpSrcStr, lpCharType)
  => DllCall("KERNEL32.dll\GetStringTypeW", UInt32, dwInfoType, "Str", lpSrcStr, Int32, lpSrcStr.Length, UInt16.Ptr, lpCharType, BOOL)
GetTextCharset(hdc1)
  => DllCall("GDI32.dll\GetTextCharset", HDC, hdc1, Int32)
GetTextCharsetInfo(hdc1, lpSig?, dwFlags)
  => DllCall("GDI32.dll\GetTextCharsetInfo", HDC, hdc1, FONTSIGNATURE.Ptr, lpSig?, UInt32, dwFlags, Int32)
GetTimeFormat(Locale, dwFlags, lpTime?, lpFormat?, lpTimeStr?)
  => DllCall("KERNEL32.dll\GetTimeFormatW", UInt32, Locale, UInt32, dwFlags, SYSTEMTIME.Ptr, lpTime?, "Str", lpFormat?, PWSTR, lpTimeStr?, Int32, lpTimeStr?.Length ?? 0, Int32)
GetTimeFormatEx(lpLocaleName?, dwFlags, lpTime?, lpFormat?, lpTimeStr?)
  => DllCall("KERNEL32.dll\GetTimeFormatEx", "Str", lpLocaleName?, TIME_FORMAT_FLAGS, dwFlags, SYSTEMTIME.Ptr, lpTime?, "Str", lpFormat?, PWSTR, lpTimeStr?, Int32, lpTimeStr?.Length ?? 0, Int32)
IsValidCodePage(CodePage)
  => DllCall("KERNEL32.dll\IsValidCodePage", UInt32, CodePage, BOOL)
MultiByteToWideChar(CodePage, dwFlags, lpMultiByteStr, lpWideCharStr?)
  => DllCall("KERNEL32.dll\MultiByteToWideChar", UInt32, CodePage, MULTI_BYTE_TO_WIDE_CHAR_FLAGS, dwFlags, PSTR, lpMultiByteStr, Int32, lpMultiByteStr.Length, PWSTR, lpWideCharStr?, Int32, lpWideCharStr?.Length ?? 0, Int32)
TranslateCharsetInfo(lpSrc, lpCs, dwFlags)
  => DllCall("GDI32.dll\TranslateCharsetInfo", UInt32.Ptr, lpSrc, CHARSETINFO.Ptr, lpCs, TRANSLATE_CHARSET_INFO_FLAGS, dwFlags, BOOL)
WideCharToMultiByte(CodePage, dwFlags, lpWideCharStr, lpMultiByteStr?, lpDefaultChar?, lpUsedDefaultChar?)
  => DllCall("KERNEL32.dll\WideCharToMultiByte", UInt32, CodePage, UInt32, dwFlags, "Str", lpWideCharStr, Int32, lpWideCharStr.Length, PSTR, lpMultiByteStr?, Int32, lpMultiByteStr?.Size ?? 0, PSTR, lpDefaultChar?, BOOL.Ptr, lpUsedDefaultChar?, Int32)
