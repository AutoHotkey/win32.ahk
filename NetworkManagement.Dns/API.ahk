#Requires AutoHotkey v2.1-alpha.37
#Include "..\_header.ahk"
#Import "Types.ahk" {*}
#Import "..\Foundation\Types.ahk" {BOOL, HANDLE, PSTR, PWSTR, WIN32_ERROR}

DnsAcquireContextHandle_(CredentialFlags, Credentials?, pContext)
  => DllCall("DNSAPI.dll\DnsAcquireContextHandle_W", UInt32, CredentialFlags, Struct.Ptr, Credentials?, HANDLE.Ptr, pContext, Int32)
DnsCancelQuery(pCancelHandle)
  => DllCall("DNSAPI.dll\DnsCancelQuery", DNS_QUERY_CANCEL.Ptr, pCancelHandle, Int32)
DnsCancelQueryRaw(cancelHandle)
  => DllCall("DNSAPI.dll\DnsCancelQueryRaw", DNS_QUERY_RAW_CANCEL.Ptr, cancelHandle, Int32)
DnsFree(pData?, FreeType)
  => DllCall("DNSAPI.dll\DnsFree", Struct.Ptr, pData?, DNS_FREE_TYPE, FreeType, "void")
DnsFreeCustomServers(pcServers, ppServers)
  => DllCall("DNSAPI.dll\DnsFreeCustomServers", UInt32.Ptr, pcServers, DNS_CUSTOM_SERVER.Ptr.Ptr, ppServers, "void")
DnsGetApplicationSettings(pcServers, ppDefaultServers, pSettings?)
  => DllCall("DNSAPI.dll\DnsGetApplicationSettings", UInt32.Ptr, pcServers, DNS_CUSTOM_SERVER.Ptr.Ptr, ppDefaultServers, DNS_APPLICATION_SETTINGS.Ptr, pSettings?, UInt32)
DnsIsFlatRecord(pRecord, ullFlags, pfFlat)
  => DllCall("DNSAPI.dll\DnsIsFlatRecord", DNS_RECORDA.Ptr, pRecord, Int64, ullFlags, BOOL.Ptr, pfFlat, Int32)
DnsQueryConfig(Config, Flag, pwsAdapterName?, pReserved?, pBuffer?, pBufLen)
  => DllCall("DNSAPI.dll\DnsQueryConfig", DNS_CONFIG_TYPE, Config, UInt32, Flag, "Str", pwsAdapterName?, Struct.Ptr, pReserved?, Struct.Ptr, pBuffer?, UInt32.Ptr, pBufLen, Int32)
DnsQueryEx(pQueryRequest, pQueryResults, pCancelHandle?)
  => DllCall("DNSAPI.dll\DnsQueryEx", DNS_QUERY_REQUEST.Ptr, pQueryRequest, DNS_QUERY_RESULT.Ptr, pQueryResults, DNS_QUERY_CANCEL.Ptr, pCancelHandle?, Int32)
DnsQueryRaw(queryRequest, cancelHandle)
  => DllCall("DNSAPI.dll\DnsQueryRaw", DNS_QUERY_RAW_REQUEST.Ptr, queryRequest, DNS_QUERY_RAW_CANCEL.Ptr, cancelHandle, Int32)
DnsQueryRawResultFree(queryResults?)
  => DllCall("DNSAPI.dll\DnsQueryRawResultFree", DNS_QUERY_RAW_RESULT.Ptr, queryResults?, "void")
DnsQuery_(pszName, wType, Options, pExtra?, ppQueryResults, pReserved?)
  => DllCall("DNSAPI.dll\DnsQuery_W", "Str", pszName, UInt16, wType, DNS_QUERY_OPTIONS, Options, Struct.Ptr, pExtra?, DNS_RECORDA.Ptr.Ptr, ppQueryResults, Struct.Ptr.Ptr, pReserved?, WIN32_ERROR)
DnsQuery_UTF8(pszName, wType, Options, pExtra?, ppQueryResults, pReserved?)
  => DllCall("DNSAPI.dll\DnsQuery_UTF8", PSTR, pszName, UInt16, wType, DNS_QUERY_OPTIONS, Options, Struct.Ptr, pExtra?, DNS_RECORDA.Ptr.Ptr, ppQueryResults, Struct.Ptr.Ptr, pReserved?, WIN32_ERROR)
DnsRecordCompare(pRecord1, pRecord2)
  => DllCall("DNSAPI.dll\DnsRecordCompare", DNS_RECORDA.Ptr, pRecord1, DNS_RECORDA.Ptr, pRecord2, BOOL)
DnsRecordCopyEx(pRecord, CharSetIn, CharSetOut)
  => DllCall("DNSAPI.dll\DnsRecordCopyEx", DNS_RECORDA.Ptr, pRecord, DNS_CHARSET, CharSetIn, DNS_CHARSET, CharSetOut, DNS_RECORDA.Ptr)
DnsRecordSetCompare(pRR1, pRR2, ppDiff1?, ppDiff2?)
  => DllCall("DNSAPI.dll\DnsRecordSetCompare", DNS_RECORDA.Ptr, pRR1, DNS_RECORDA.Ptr, pRR2, DNS_RECORDA.Ptr.Ptr, ppDiff1?, DNS_RECORDA.Ptr.Ptr, ppDiff2?, BOOL)
DnsRecordSetCopyEx(pRecordSet, CharSetIn, CharSetOut)
  => DllCall("DNSAPI.dll\DnsRecordSetCopyEx", DNS_RECORDA.Ptr, pRecordSet, DNS_CHARSET, CharSetIn, DNS_CHARSET, CharSetOut, DNS_RECORDA.Ptr)
DnsRecordSetDetach(pRecordList)
  => DllCall("DNSAPI.dll\DnsRecordSetDetach", DNS_RECORDA.Ptr, pRecordList, DNS_RECORDA.Ptr)
DnsSetApplicationSettings(pServers, pSettings?)
  => DllCall("DNSAPI.dll\DnsSetApplicationSettings", UInt32, pServers.Length, DNS_CUSTOM_SERVER.Ptr, pServers, DNS_APPLICATION_SETTINGS.Ptr, pSettings?, UInt32)
