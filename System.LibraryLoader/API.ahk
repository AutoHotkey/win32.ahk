#Requires AutoHotkey v2.1-alpha.37
#Include "..\_header.ahk"
#Import "Types.ahk" {*}
#Import "..\Foundation\Types.ahk" {BOOL, FARPROC, HANDLE, HGLOBAL, HMODULE, HRSRC, PSTR, PWSTR}

AddDllDirectory(NewDirectory)
  => DllCall("KERNEL32.dll\AddDllDirectory", "Str", NewDirectory, Struct.Ptr)
DisableThreadLibraryCalls(hLibModule)
  => DllCall("KERNEL32.dll\DisableThreadLibraryCalls", HMODULE, hLibModule, BOOL)
EnumResourceLanguagesEx(hModule1?, lpType, lpName, lpEnumFunc, lParam?, dwFlags, LangId)
  => DllCall("KERNEL32.dll\EnumResourceLanguagesExW", HMODULE, hModule1?, "Str", lpType, "Str", lpName, ENUMRESLANGPROCW, lpEnumFunc, IntPtr, lParam?, UInt32, dwFlags, UInt16, LangId, BOOL)
EnumResourceNames(hModule1?, lpType, lpEnumFunc, lParam)
  => DllCall("KERNEL32.dll\EnumResourceNamesW", HMODULE, hModule1?, "Str", lpType, ENUMRESNAMEPROCW, lpEnumFunc, IntPtr, lParam, BOOL)
EnumResourceNamesEx(hModule1?, lpType, lpEnumFunc, lParam, dwFlags, LangId)
  => DllCall("KERNEL32.dll\EnumResourceNamesExW", HMODULE, hModule1?, "Str", lpType, ENUMRESNAMEPROCW, lpEnumFunc, IntPtr, lParam, UInt32, dwFlags, UInt16, LangId, BOOL)
EnumResourceTypesEx(hModule1?, lpEnumFunc, lParam, dwFlags, LangId)
  => DllCall("KERNEL32.dll\EnumResourceTypesExW", HMODULE, hModule1?, ENUMRESTYPEPROCW, lpEnumFunc, IntPtr, lParam, UInt32, dwFlags, UInt16, LangId, BOOL)
FindResourceExW(hModule1?, lpType, lpName, wLanguage)
  => DllCall("KERNEL32.dll\FindResourceExW", HMODULE, hModule1?, "Str", lpType, "Str", lpName, UInt16, wLanguage, HRSRC)
FindResourceW(hModule1?, lpName, lpType)
  => DllCall("KERNEL32.dll\FindResourceW", HMODULE, hModule1?, "Str", lpName, "Str", lpType, HRSRC)
FreeLibraryAndExitThread(hLibModule, dwExitCode)
  => DllCall("KERNEL32.dll\FreeLibraryAndExitThread", HMODULE, hLibModule, UInt32, dwExitCode, "void")
FreeResource(hResData)
  => DllCall("KERNEL32.dll\FreeResource", HGLOBAL, hResData, BOOL)
GetModuleFileName(hModule1?, lpFilename)
  => DllCall("KERNEL32.dll\GetModuleFileNameW", HMODULE, hModule1?, PWSTR, lpFilename, UInt32, lpFilename.Length, UInt32)
GetModuleHandle(lpModuleName?)
  => DllCall("KERNEL32.dll\GetModuleHandleW", "Str", lpModuleName?, HMODULE)
GetModuleHandleEx(dwFlags, lpModuleName?, phModule)
  => DllCall("KERNEL32.dll\GetModuleHandleExW", UInt32, dwFlags, "Str", lpModuleName?, HMODULE.Ptr, phModule, BOOL)
GetProcAddress(hModule1, lpProcName)
  => DllCall("KERNEL32.dll\GetProcAddress", HMODULE, hModule1, PSTR, lpProcName, FARPROC)
LoadLibrary(lpLibFileName)
  => DllCall("KERNEL32.dll\LoadLibraryW", "Str", lpLibFileName, HMODULE)
LoadLibraryEx(lpLibFileName, dwFlags)
  => DllCall("KERNEL32.dll\LoadLibraryExW", "Str", lpLibFileName, "Ptr", 0, LOAD_LIBRARY_FLAGS, dwFlags, HMODULE)
LoadResource(hModule1?, hResInfo)
  => DllCall("KERNEL32.dll\LoadResource", HMODULE, hModule1?, HRSRC, hResInfo, HGLOBAL)
LockResource(hResData)
  => DllCall("KERNEL32.dll\LockResource", HGLOBAL, hResData, Struct.Ptr)
RemoveDllDirectory(Cookie)
  => DllCall("KERNEL32.dll\RemoveDllDirectory", Struct.Ptr, Cookie, BOOL)
SetDefaultDllDirectories(DirectoryFlags)
  => DllCall("KERNEL32.dll\SetDefaultDllDirectories", LOAD_LIBRARY_FLAGS, DirectoryFlags, BOOL)
SizeofResource(hModule1?, hResInfo)
  => DllCall("KERNEL32.dll\SizeofResource", HMODULE, hModule1?, HRSRC, hResInfo, UInt32)
