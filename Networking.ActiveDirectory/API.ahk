#Requires AutoHotkey v2.1-alpha.37
#Include "..\_header.ahk"
#Import "Types.ahk" {*}
#Import "..\Foundation\Types.ahk" {BOOL, HRESULT, PWSTR}
#Import "..\Security\Types.ahk" {PSECURITY_DESCRIPTOR}
#Import "..\System.Ole\Types.ahk" {IEnumVARIANT}
#Import "..\System.Variant\Types.ahk" {VARIANT}

ADsBuildEnumerator(pADsContainer, ppEnumVariant)
  => DllCall("ACTIVEDS.dll\ADsBuildEnumerator", IADsContainer, pADsContainer, IEnumVARIANT.Ptr, ppEnumVariant, "HRESULT")
ADsBuildVarArrayInt(lpdwObjectTypes, dwObjectTypes, pVar)
  => DllCall("ACTIVEDS.dll\ADsBuildVarArrayInt", UInt32.Ptr, lpdwObjectTypes, UInt32, dwObjectTypes, VARIANT.Ptr, pVar, "HRESULT")
ADsBuildVarArrayStr(lppPathNames, pVar)
  => DllCall("ACTIVEDS.dll\ADsBuildVarArrayStr", PWSTR.Ptr, lppPathNames, UInt32, lppPathNames.Length, VARIANT.Ptr, pVar, "HRESULT")
ADsDecodeBinaryData(szSrcData, ppbDestData, pdwDestLen)
  => DllCall("ACTIVEDS.dll\ADsDecodeBinaryData", "Str", szSrcData, UInt8.Ptr.Ptr, ppbDestData, UInt32.Ptr, pdwDestLen, "HRESULT")
ADsEncodeBinaryData(pbSrcData, dwSrcLen, ppszDestData)
  => DllCall("ACTIVEDS.dll\ADsEncodeBinaryData", UInt8.Ptr, pbSrcData, UInt32, dwSrcLen, PWSTR.Ptr, ppszDestData, "HRESULT")
ADsEnumerateNext(pEnumVariant, cElements, pvar, pcElementsFetched)
  => DllCall("ACTIVEDS.dll\ADsEnumerateNext", IEnumVARIANT, pEnumVariant, UInt32, cElements, VARIANT.Ptr, pvar, UInt32.Ptr, pcElementsFetched, "HRESULT")
ADsFreeEnumerator(pEnumVariant)
  => DllCall("ACTIVEDS.dll\ADsFreeEnumerator", IEnumVARIANT, pEnumVariant, "HRESULT")
ADsGetLastError(lpError, lpErrorBuf, lpNameBuf)
  => DllCall("ACTIVEDS.dll\ADsGetLastError", UInt32.Ptr, lpError, PWSTR, lpErrorBuf, UInt32, lpErrorBuf.Length, PWSTR, lpNameBuf, UInt32, lpNameBuf.Length, "HRESULT")
ADsGetObject(lpszPathName, riid, ppObject)
  => DllCall("ACTIVEDS.dll\ADsGetObject", "Str", lpszPathName, GUID.Ptr, riid, Struct.Ptr.Ptr, ppObject, "HRESULT")
ADsOpenObject(lpszPathName, lpszUserName, lpszPassword, dwReserved, riid, ppObject)
  => DllCall("ACTIVEDS.dll\ADsOpenObject", "Str", lpszPathName, "Str", lpszUserName, "Str", lpszPassword, ADS_AUTHENTICATION_ENUM, dwReserved, GUID.Ptr, riid, Struct.Ptr.Ptr, ppObject, "HRESULT")
ADsSetLastError(dwErr, pszError, pszProvider)
  => DllCall("ACTIVEDS.dll\ADsSetLastError", UInt32, dwErr, "Str", pszError, "Str", pszProvider, "void")
AdsFreeAdsValues(pAdsValues, dwNumValues)
  => DllCall("ACTIVEDS.dll\AdsFreeAdsValues", ADSVALUE.Ptr, pAdsValues, UInt32, dwNumValues, "void")
AdsTypeToPropVariant(pAdsValues, dwNumValues, pVariant)
  => DllCall("ACTIVEDS.dll\AdsTypeToPropVariant", ADSVALUE.Ptr, pAdsValues, UInt32, dwNumValues, VARIANT.Ptr, pVariant, "HRESULT")
AllocADsMem(cb)
  => DllCall("ACTIVEDS.dll\AllocADsMem", UInt32, cb, Struct.Ptr)
AllocADsStr(pStr)
  => DllCall("ACTIVEDS.dll\AllocADsStr", "Str", pStr, PWSTR)
BinarySDToSecurityDescriptor(pSecurityDescriptor, pVarsec, pszServerName, userName, passWord, dwFlags)
  => DllCall("ACTIVEDS.dll\BinarySDToSecurityDescriptor", PSECURITY_DESCRIPTOR, pSecurityDescriptor, VARIANT.Ptr, pVarsec, "Str", pszServerName, "Str", userName, "Str", passWord, UInt32, dwFlags, "HRESULT")
DsBrowseForContainer(pInfo)
  => DllCall("dsuiext.dll\DsBrowseForContainerW", DSBROWSEINFOW.Ptr, pInfo, Int32)
FreeADsMem(pMem)
  => DllCall("ACTIVEDS.dll\FreeADsMem", Struct.Ptr, pMem, BOOL)
FreeADsStr(pStr)
  => DllCall("ACTIVEDS.dll\FreeADsStr", "Str", pStr, BOOL)
PropVariantToAdsType(pVariant, dwNumVariant, ppAdsValues, pdwNumValues)
  => DllCall("ACTIVEDS.dll\PropVariantToAdsType", VARIANT.Ptr, pVariant, UInt32, dwNumVariant, ADSVALUE.Ptr.Ptr, ppAdsValues, UInt32.Ptr, pdwNumValues, "HRESULT")
ReallocADsMem(pOldMem, cbOld, cbNew)
  => DllCall("ACTIVEDS.dll\ReallocADsMem", Struct.Ptr, pOldMem, UInt32, cbOld, UInt32, cbNew, Struct.Ptr)
ReallocADsStr(ppStr, pStr)
  => DllCall("ACTIVEDS.dll\ReallocADsStr", PWSTR.Ptr, ppStr, "Str", pStr, BOOL)
SecurityDescriptorToBinarySD(vVarSecDes, ppSecurityDescriptor, pdwSDLength, pszServerName, userName, passWord, dwFlags)
  => DllCall("ACTIVEDS.dll\SecurityDescriptorToBinarySD", VARIANT, vVarSecDes, PSECURITY_DESCRIPTOR.Ptr, ppSecurityDescriptor, UInt32.Ptr, pdwSDLength, "Str", pszServerName, "Str", userName, "Str", passWord, UInt32, dwFlags, "HRESULT")
